set_global_assignment -name SYSTEMVERILOG_FILE rtl/core/memory_arbiter.sv
set_global_assignment -name VERILOG_FILE rtl/core/tv80lx.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/core/mmu_native.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/core/vga_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/core/video_ctrl_vga.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/core/mist_loader.sv
set_global_assignment -name VERILOG_FILE rtl/core/cpc/UM6845R.v
